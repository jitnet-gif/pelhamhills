# 저장소 루트 .env 의 템플릿. `cp .env.example .env` 로 시작한다.
# `.env` 는 .gitignore 에 걸려 있다 — 실제 키를 여기(.env.example)에 적지 말 것.
#
# 백엔드는 `backend/core/config.py` 의 find_env_file() 이 상위 디렉터리로 올라가며
# 찾은 `.env` 를 읽는다. 음성 예약 스크립트도 같은 파일을 읽는다.

# ===========================================================================
# ElevenLabs 음성 예약  (자세한 내용: docs/VOICE_BOOKING.md)
# ===========================================================================

# ⚠️ Agents Platform 은 TTS 전용 키로 동작하지 않는다. 키를 만들 때
#    convai_read 와 convai_write 를 반드시 켤 것. 빠지면 401 에
#    "missing the permission convai_read" 가 찍힌다.
ELEVENLABS_API_KEY=

# `python scripts/elevenlabs_sync_agent.py` 가 에이전트를 만들면 찍어 준다.
# 비워 두면 실행할 때마다 새 에이전트가 생긴다.
ELEVENLABS_AGENT_ID=

# 에이전트의 웹훅 도구가 우리 서버를 부를 때 실어 보내는 공유 시크릿.
# ⚠️ 비어 있으면 /api/v1/voice/tools/* 가 인증 없이 열린다. 그 상태로는
#    누구나 예약을 만들고 취소할 수 있다. 로컬 개발 편의를 위한 것이므로
#    배포에서는 반드시 채울 것.
VOICE_TOOL_SECRET=

# post-call 웹훅 HMAC 검증용. ElevenLabs 대시보드가 발급한다.
ELEVENLABS_WEBHOOK_SECRET=

# 에이전트가 우리 도구를 호출할 **공개** 주소. ElevenLabs 서버는 localhost 에
# 닿지 못하므로, 로컬 테스트에는 ngrok 등의 터널 주소가 필요하다.
#   로컬: https://<주소>.ngrok-free.app/api/v1
#   배포: https://<api 도메인>/api/v1
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# 골프장 현지 시간대. "이 티타임이 이미 지났나" 를 UTC 로 판단하면 안 된다.
CLUB_TIMEZONE=America/Toronto

# ===========================================================================
# Twilio 문자  (자세한 내용: docs/VOICE_BOOKING.md "전화번호와 문자")
# ===========================================================================

# 비어 있으면 문자는 보내지 않고 기록만 남는다. /sms/* 웹훅은 거절된다.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# 있으면 TWILIO_PHONE_NUMBER 대신 이걸로 보낸다.
TWILIO_MESSAGING_SERVICE_SID=

# 답장으로 해결 안 되는 일을 안내할 프로 샵 번호.
PROSHOP_PHONE_NUMBER=+19057356768

# ===========================================================================
# 결제 — Stripe: 온라인 Checkout + 계산대 Terminal (backend/api/routes/payments.py, terminal.py)
# ===========================================================================

# 비어 있으면 결제를 끈다: 예약 화면에 Pay now 가 나오지 않고, 계산대는 승인번호를 손으로 친다.
# Dashboard → Developers → API keys. sk_test_… 이면 테스트 모드(가상 리더·테스트 카드), sk_live_… 이면 실결제.
STRIPE_SECRET_KEY=
# 웹훅 서명 키(whsec_…). Dashboard → Developers → Webhooks 에서 엔드포인트를 만들면 나온다.
# 없으면 /payments/stripe/webhook 이 400 이다(결과 화면·계산대는 Stripe 에 직접 물어 계속 동작한다).
STRIPE_WEBHOOK_SECRET=
# 리더를 등록할 Terminal Location(tml_…). 비우면 첫 Location 을 쓴다(테스트 모드에서는 없으면 만든다).
STRIPE_TERMINAL_LOCATION=
# 결제 뒤 돌아갈 사이트(부른 페이지가 CORS 허용 목록에 없을 때만 쓴다).
PUBLIC_SITE_URL=https://pelhamhills-golf.vercel.app
