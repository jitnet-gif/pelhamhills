# Backend Environment Variables Template
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# ============================================
# Application Configuration
# ============================================
PROJECT_NAME=Pelham Hills Golf Backend
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://bepu:password@localhost:5432/bepu_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ============================================
# API Configuration
# ============================================
API_V1_STR=/api/v1
API_TITLE=Golf Course API
API_VERSION=1.0.0
# CORS 허용 출처. 코드가 읽는 키는 ALLOWED_ORIGINS 다 (core/config.py).
# 3000 = Next 웹사이트, 5173/4173 = golf-gps-app 의 Vite 개발/미리보기 서버.
# GPS 앱의 /book 화면이 이 백엔드의 /tee-sheet/* 를 직접 부르므로 함께 넣는다.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:4173,https://your-app.vercel.app

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret
# 티 시트 저장 엔진. json(기본값) = backend/data/tee_sheet.json 파일 하나.
# supabase = pelham_tee_bookings 테이블. 위 SUPABASE_URL 과 SUPABASE_SERVICE_ROLE_KEY 가
# 필요하고, supabase/migrations/0002_tee_bookings.sql 이 먼저 적용돼 있어야 한다.
TEE_SHEET_BACKEND=json

# ============================================
# Anthropic/Claude Configuration
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Cloudflare Configuration
# ============================================
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_ACCESS_KEY_SECRET=your_access_key_secret
R2_BUCKET_NAME=golf-tiles
CDN_DOMAIN=https://your-bucket.cdn.jsdelivr.net

# ============================================
# Authentication
# ============================================
AUTH_SECRET=your_auth_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@golfapp.com
SMTP_FROM_NAME=Golf Course App

# ============================================
# AWS Configuration (Alternative to Cloudflare)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=golf-tiles

# ============================================
# Feature Flags
# ============================================
ENABLE_LIVE_SCORING=true
ENABLE_AI_CADDY=true
ENABLE_LEADERBOARD=true
ENABLE_NOTIFICATIONS=true

# ============================================
# Monitoring & Analytics
# ============================================
SENTRY_DSN=your_sentry_dsn_url
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Security
# ============================================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SECRET_KEY=your_django_secret_key_here
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTH=5/minute

# ============================================
# Caching
# ============================================
CACHE_BACKEND=redis
CACHE_TIMEOUT=300
CACHE_KEY_PREFIX=golf_

# ============================================
# Celery Configuration (Optional - for async tasks)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ============================================
# Payments — Stripe Checkout + Terminal (backend/api/routes/payments.py, terminal.py)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TERMINAL_LOCATION=

# ============================================
# Google Configuration (Optional - for OAuth)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# Development Only
# ============================================
DEVELOPMENT_MODE=true
ALLOW_ADMIN_API=true
SEED_DATABASE=true
